fn some_function(int param1, int param2, int param3) -> int
	const local_const = 5
	bool is_thing_enabled = no

	if param1 < local_const # Don't need a : at the end of the line.
		print(param1)
	elif param2 > 5
		print(param2)
	else
		print("Fail!")

	for i in range(20)
		print(i)

	for int i in range(10)
		print(i)

	# Single and multiline if statements need a ":"
	if 1 > 0: return

	if param1 < local_const \
		1 > 0:
			print(param1)

	next_state = "idle" if yes != no else "fall"

	int angle_degrees = 135
	String quadrant = (
			"northeast" if angle_degrees <= 90
			else "southeast" if angle_degrees <= 180
			else "southwest" if angle_degrees <= 270
			else "northwest"
	)

	var position := vec2(250, 350)
	if (
			position.x > 200 and position.x < 400
			and position.y > 300 and position.y < 400
	):
		pass

	while param2 != 0
		param2 -= 1

	match param3
		3:
			print("param3 is 3!")
		_:
			print("param3 is not 3!")

	int local_var = param1 + 3
	return local_var


